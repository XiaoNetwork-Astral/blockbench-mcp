{
  "name": "blockbench-mcp",
  "version": "2.2.0",
  "description": "Local Blockbench MCP server with direct visible-tab modeling, audit history, and YSM/Hytale support",
  "keywords": [
    "Blockbench",
    "MCP"
  ],
  "license": "GPL-3.0-only",
  "author": "Jason J. Gardner and OpenAI Codex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoNetwork-Astral/blockbench-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/XiaoNetwork-Astral/blockbench-mcp/issues"
  },
  "type": "module",
  "main": "dist/blockbench_mcp.js",
  "scripts": {
    "test": "bun test tests",
    "test:blockbench": "bun test tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test tests",
    "prompts:build": "bun run ./build/generate-manifest.ts",
    "dev": "bun run prompts:build && bun run ./build --clean --sourcemap",
    "dev:watch": "bun run dev --watch",
    "build": "bun run prompts:build && bun run ./build --clean --minify",
    "inspect": "bunx @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "jsonc-parser": "3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.8",
    "blockbench-types": "^5.1.0",
    "typescript": "^5.9.3"
  }
}
